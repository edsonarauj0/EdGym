# Environment Variables - GymTracker
# Copy this file to .env.local and fill in your values
# On Vercel, add each variable in the project settings under "Environment Variables"

# ─── Firebase ───────────────────────────────────────────────────────────────
# Firebase - Client SDK (público, seguro para o frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase - Admin SDK (SECRETO! Apenas no servidor / Vercel env vars)
# Gere em: Firebase Console → Configurações → Contas de serviço → Gerar nova chave
# Cole o conteúdo do JSON em UMA linha
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ─── Google Gemini AI ────────────────────────────────────────────────────────
VITE_GEMINI_API_KEY=your_gemini_api_key

# ─── Cloudinary (free image hosting) ────────────────────────────────────────
# Create free account at https://cloudinary.com
# Cloud name: found in your Cloudinary Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Upload Preset: Dashboard → Settings → Upload → Add upload preset (set to "Unsigned")
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
